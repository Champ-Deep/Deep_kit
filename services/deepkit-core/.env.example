# =============================================================================
# DEEPKIT CORE CONFIGURATION
# COMMAND CENTER - Central AI Interface for the DeepKit Arsenal
# =============================================================================

# --- Server ---
PORT=7777
NODE_ENV=production
LOG_LEVEL=info

# =============================================================================
# DEEPKIT SERVICES (THE ARSENAL)
# =============================================================================

# THE VAULT (PostgreSQL)
DEEPKIT_POSTGRES_HOST=deepkit-store
DEEPKIT_POSTGRES_PORT=5432
DEEPKIT_POSTGRES_DB=messenger
DEEPKIT_POSTGRES_USER=deepkit
DEEPKIT_POSTGRES_PASSWORD=          # REQUIRED - generated by install.sh

# THE CACHE (Redis)
REDIS_HOST=deepkit-cache
REDIS_PORT=6379
REDIS_PASSWORD=                     # REQUIRED - generated by install.sh

# THE BRAIN (Ollama - Local LLM)
OLLAMA_BASE_URL=http://deepkit-engine:11434
OLLAMA_MODEL=llama3.2:latest

# THE ENGINE (n8n Automation)
N8N_WEBHOOK_URL=http://deepkit-orchestrator:5678
N8N_API_KEY=

# =============================================================================
# SECURITY
# =============================================================================

# Internal API token for service-to-service auth and webhooks.
# No user login required - DeepKit runs locally.
DEEPKIT_INTERNAL_TOKEN=             # REQUIRED - generated by install.sh

# =============================================================================
# MESSAGING PLATFORMS (Optional)
# =============================================================================

# WhatsApp (Whatomate)
WHATOMATE_API_KEY=
WHATOMATE_VERIFY_TOKEN=deepkit-verify

# =============================================================================
# OPTIONAL EXTERNAL INTEGRATIONS
# =============================================================================

NOTION_API_KEY=
SENDGRID_API_KEY=
SLACK_WEBHOOK_URL=

# =============================================================================
# CONVERSATION SETTINGS
# =============================================================================

MAX_CONVERSATION_HISTORY=20
CONVERSATION_TIMEOUT=1800000
