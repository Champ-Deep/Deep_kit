# ============================================================================
# DEEPKIT MESSENGER CONFIGURATION
# THE PROXY - Natural Language Interface to the DeepKit Arsenal
# ============================================================================

# Application Settings
NODE_ENV=development
PORT=3333
LOG_LEVEL=info

# ============================================================================
# DEEPKIT SERVICES (THE ARSENAL)
# ============================================================================

# THE VAULT (Postgres Database)
DEEPKIT_POSTGRES_HOST=postgres
DEEPKIT_POSTGRES_PORT=5432
DEEPKIT_POSTGRES_DB=deepkit_brain
DEEPKIT_POSTGRES_USER=deepkit
DEEPKIT_POSTGRES_PASSWORD=your_secure_password_here

# THE BRAIN (Ollama - Local LLM)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:latest
EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TIMEOUT=120000

# THE ENGINE (n8n Automation)
N8N_WEBHOOK_URL=http://n8n:5678
N8N_API_KEY=

# THE MEMORY (Qdrant Vector Store - Optional)
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# ============================================================================
# MESSAGING PLATFORMS
# ============================================================================

# WhatsApp (Whatomate)
WHATOMATE_URL=http://whatomate:8080
WHATOMATE_API_KEY=your_whatomate_api_key_here
WHATOMATE_VERIFY_TOKEN=deepkit-verify

# ============================================================================
# OPTIONAL EXTERNAL INTEGRATIONS
# ============================================================================

# Notion (Optional)
NOTION_API_KEY=
NOTION_WORKSPACE_LAKEB2B=
NOTION_WORKSPACE_AMPLIZ=
NOTION_WORKSPACE_CHAMPIONS_ACCELERATOR=
NOTION_WORKSPACE_CHAMPIONS_GROUP=
NOTION_WORKSPACE_RECRUITCHAMP=
NOTION_WORKSPACE_METRICFOX=
NOTION_WORKSPACE_IP_MOMENTUM=

# SendGrid (Optional)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# Slack (Optional)
SLACK_WEBHOOK_URL=

# ============================================================================
# BUSINESS ROUTING
# ============================================================================

BUSINESS_PRIMARY_THRESHOLD=7
BUSINESS_SECONDARY_THRESHOLD=4

# ============================================================================
# CONVERSATION SETTINGS
# ============================================================================

MAX_CONVERSATION_HISTORY=10
CONVERSATION_TIMEOUT=1800000
RESPONSE_STYLE=brief
