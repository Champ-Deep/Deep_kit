# =============================================================================
# DEEP STARTER KIT - Environment Configuration
# =============================================================================
#
# QUICK START:
#   1. Copy this file: cp .env.example .env
#   2. Run: ./install.sh (generates secure passwords automatically!)
#
# The installer will fill in all required values for you.
# =============================================================================

# -----------------------------------------------------------------------------
# CORE (Required)
# -----------------------------------------------------------------------------
# Shared PostgreSQL database
POSTGRES_USER=deepkit
POSTGRES_PASSWORD=
POSTGRES_DB=deepkit

# Timezone for all services
TIMEZONE=UTC

# -----------------------------------------------------------------------------
# MODULE A: Workflow Automation (n8n)
# -----------------------------------------------------------------------------
# Required if using n8n
N8N_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# MODULE D: Content Management (Strapi)
# -----------------------------------------------------------------------------
# Required if using Strapi CMS
STRAPI_JWT_SECRET=
STRAPI_ADMIN_JWT_SECRET=
STRAPI_APP_KEYS=

# -----------------------------------------------------------------------------
# MODULE E: Customer Management (EspoCRM)
# -----------------------------------------------------------------------------
# Required if using EspoCRM
MARIADB_ROOT_PASSWORD=
ESPOCRM_DB_PASSWORD=
ESPOCRM_ADMIN_USERNAME=admin
ESPOCRM_ADMIN_PASSWORD=
ESPOCRM_SITE_URL=http://localhost:3004

# -----------------------------------------------------------------------------
# AI API KEYS (Optional)
# -----------------------------------------------------------------------------
# Leave blank to use only local Ollama models
# Fill in to enable cloud AI features

# OpenAI (GPT-4, embeddings)
OPENAI_API_KEY=

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# PORT REFERENCE
# -----------------------------------------------------------------------------
# Core Services:
#   5432  - PostgreSQL
#   6379  - Redis
#   11434 - Ollama
#   9000  - Portainer
#
# Optional Modules:
#   3001  - Open WebUI (Module B)
#   3002  - NotebookLM (Module C)
#   3003  - Strapi CMS (Module D)
#   3004  - EspoCRM (Module E)
#   3005  - chamPDF (Module F)
#   3011  - FalkorDB Browser (Module G)
#   3306  - MariaDB (Module E)
#   5678  - n8n (Module A)
#   6333  - Qdrant (Module H)
#   6380  - FalkorDB (Module G)
#   8000  - Graphiti (Module G)
#   9002  - Uptime Kuma (Module I)
#   9003  - Adminer (Module J)
