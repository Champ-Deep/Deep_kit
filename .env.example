# =============================================================================
# DEEPKIT - Environment Configuration
# =============================================================================
# This file is generated from config/environment-registry.json
# Copy to .env and run: node scripts/generate-secrets.js
#
# Secrets marked [AUTO] will be generated during installation.
# Secrets marked [REQUIRED] must be set manually.
# =============================================================================

# -----------------------------------------------------------------------------
# CORE INFRASTRUCTURE
# -----------------------------------------------------------------------------
# PostgreSQL database username (lowercase, starts with letter)
POSTGRES_USER=deepkit

# PostgreSQL database password [AUTO]
# Requirements: 16+ chars, 80-bit entropy minimum
POSTGRES_PASSWORD=

# Default PostgreSQL database name
POSTGRES_DB=deepkit

# PostgreSQL container hostname (for Docker networking)
POSTGRES_HOST=deepkit-store
POSTGRES_PORT=5432

# Redis configuration
REDIS_HOST=deepkit-cache
REDIS_PORT=6379

# Redis authentication password [AUTO]
# Requirements: 16+ chars, 80-bit entropy minimum
REDIS_PASSWORD=

# Node environment
NODE_ENV=production

# System timezone (IANA format, e.g., America/New_York)
TIMEZONE=UTC

# -----------------------------------------------------------------------------
# SECURITY SECRETS
# -----------------------------------------------------------------------------
# Service-to-service authentication token [AUTO]
# Requirements: 64-char hexadecimal
# Used by: All DeepKit services for internal API calls
DEEPKIT_INTERNAL_TOKEN=

# Traefik gateway BasicAuth credentials [REQUIRED for gateway]
# Format: user:$apr1$hash (htpasswd format)
# Generate with: htpasswd -nb admin yourpassword
GATEWAY_AUTH_USERS=

# Grafana admin password [AUTO]
# Requirements: 12+ chars
GRAFANA_PASSWORD=

# Password Manager encryption key [AUTO]
# Requirements: 64-char hexadecimal
# Used by: password-manager service
ENCRYPTION_KEY=

# n8n workflow encryption key [AUTO]
# Requirements: 32+ chars
# Used by: automation (n8n orchestrator)
N8N_ENCRYPTION_KEY=

# Strapi CMS JWT secret [AUTO]
# Requirements: 32+ chars
# Used by: content (Strapi CMS)
STRAPI_JWT_SECRET=

# -----------------------------------------------------------------------------
# EXTERNAL APIS (Optional - for AI features)
# -----------------------------------------------------------------------------
# Google Gemini API key
# Get yours at: https://makersuite.google.com/app/apikey
# Used by: marketing360, chat, research, messenger
GEMINI_API_KEY=

# OpenAI API key
# Get yours at: https://platform.openai.com/api-keys
# Used by: chat, research, cowork
OPENAI_API_KEY=

# Ollama API URL (for local LLM - THE BRAIN)
# Default connects to the bundled Ollama container
OLLAMA_HOST=http://deepkit-engine:11434

# -----------------------------------------------------------------------------
# MESSAGING CHANNELS (Phase 4)
# -----------------------------------------------------------------------------
# Telegram Bot Token [OPTIONAL]
# Get yours from @BotFather: https://t.me/botfather
# Used by: Gateway service for Telegram integration
TELEGRAM_BOT_TOKEN=

# WhatsApp Integration via n8n [OPTIONAL]
# Configure n8n with Evolution API or WhatsApp Business API
# n8n webhook URL for sending WhatsApp messages
N8N_WEBHOOK_URL=http://n8n:5678/webhook/whatsapp-outbound

# OpenCode Configuration [AUTO]
# Used by: Core API for AI processing
OPENCODE_URL=http://opencode:4096
OPENCODE_USERNAME=opencode
OPENCODE_PASSWORD=

# Core API Configuration
CORE_API_URL=http://core-api:7777
TASK_TRACKER_URL=http://task-tracker:7718
